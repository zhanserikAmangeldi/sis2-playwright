{
  "name": "sis2-playwright",
  "version": "1.0.0",
  "description": "SIS 2 - Playwright test suite for the Toolshop (practicesoftwaretesting.com)",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:ui": "playwright test --ui",
    "test:bugs": "cross-env BASE_URL=https://with-bugs.practicesoftwaretesting.com API_URL=https://api-with-bugs.practicesoftwaretesting.com playwright test",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "cross-env": "^10.1.0",
    "typescript": "^7.0.2"
  }
}
